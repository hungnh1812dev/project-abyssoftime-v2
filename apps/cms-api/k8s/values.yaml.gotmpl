# cms-api's (non-secret) chart values for helmfile-chart-template. The identity values (appName,
# serviceName, appNamespace, appEnv, appPort) come from required APP_* env vars in helmfile.yaml.gotmpl,
# and the image tag from APP_IMAGE_TAG here (a .gotmpl, so helmfile templates it). Runtime
# config and secrets come from the abyssoftime-cms-api-secrets-prod Secret, which helmfile renders from
# exported env vars via the secrets release — never here.

# pullPolicy defaults to Always in the chart, so a re-pushed `latest` is picked up on pod restart.
# APP_IMAGE_TAG is `latest` or a commit's short SHA (e.g. 7074d17) to pin/roll back.
image:
  repository: {{ requiredEnv "APP_IMAGE_REPO" | quote }}
  tag: {{ requiredEnv "APP_IMAGE_TAG" | quote }}

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 512Mi

# Loads abyssoftime-cms-api-secrets-prod via envFrom into the app and the migrate init container.
secrets:
  enabled: true

# Runs `prisma migrate deploy` (the migrator target's CMD) before the app starts.
initContainers:
  enabled: true
  containers:
    - name: init
      # Same tag as the app plus `-migrate`, so the pair always comes from one commit.
      image: {{ requiredEnv "APP_INIT_IMAGE_REPO" | quote }}:{{ requiredEnv "APP_INIT_IMAGE_TAG" | quote }}
      # Needed explicitly: the chart's pullPolicy only covers the main container, and Kubernetes only
      # defaults to Always for a tag that is exactly `latest`.
      imagePullPolicy: Always

# The chart defaults probe paths to /healthz; cms-api serves /health (outside the api/v1 prefix).
probes:
  enabled: true
  liveness:
    path: /health
    initialDelaySeconds: 15
    periodSeconds: 20
  readiness:
    path: /health
    initialDelaySeconds: 5
    periodSeconds: 10
