# cms-api k3s deploy config — copy to k8s/.env.local (gitignored) and fill in, then export it:
#   set -a && . ./.env.local && set +a && helmfile cache cleanup && helmfile apply
# helmfile uses APP_* as identity vars and puts every other key listed here into the
# abyssoftime-cms-api-secrets-prod Secret, taking values from the environment. Empty keys are left
# out (the app uses its defaults). A key missing from this file never reaches the Secret.

# ── helmfile identity (required, not put in the Secret) ──────────────────────
APP_NAME=abyssoftime
APP_SERVICE_NAME=cms-api
APP_NAMESPACE=abyssoftime
APP_ENV=prod
# Container/Service port. Also becomes the Secret's PORT, so don't set PORT here.
APP_PORT=3000
# Image tag: latest, or a commit's short SHA (e.g. 7074d17) to pin/roll back. The migrate init
# container uses <tag>-migrate.
APP_IMAGE_REPO=
APP_IMAGE_TAG=
APP_INIT_IMAGE_REPO=
APP_INIT_IMAGE_TAG=

# ── JWT (required) — generate each with: openssl rand -base64 32 ─────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS (required) — comma-separated exact origins, e.g. https://admin.example.com
CORS_ORIGINS=

# ── Reverse-proxy hops. Default 1 (one ingress-nginx hop) ────────────────────
TRUST_PROXY=1

# ── Rate limit (auth-mutation routes). Defaults: 5 / 10 ─────────────────────
RATE_LIMIT_FPS=
RATE_LIMIT_BURST=

# ── Content types dir. Default content-types ───────────────────────────────
CONTENT_TYPES_DIR=

# ── Media — max upload bytes. Default 10485760 (10 MiB) ────────────────────
MEDIA_MAX_UPLOAD_BYTES=

# ── Database (required) — Postgres on the Mac, reached via its bridge IP ────
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── Storage — cloudinary (default) or s3; fill in only the one you use ─────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_S3_BUCKET=

# ── Email — gmail | smtp | resend | brevo | console (default) ───────────────
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
RESEND_API_KEY=
BREVO_API_KEY=

# ── Redis (optional refresh-token blacklist cache). REDIS_URL required if true
REDIS_ENABLED=false
REDIS_URL=
