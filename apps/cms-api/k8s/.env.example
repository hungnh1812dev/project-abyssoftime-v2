# cms-api runtime Secret template — the keys of <app-name>-<app-service-name>-<app-env>-secrets,
# which the owner creates by hand before the first Flux deploy (placeholders only here). Copy to
# k8s/.env.local (gitignored), fill it in, then create the Secret in <app-namespace>-<app-env>,
# keeping only non-empty keys so unset ones fall back to the app's defaults:
#   kubectl -n <app-namespace>-<app-env> create secret generic \
#     <app-name>-<app-service-name>-<app-env>-secrets \
#     --from-env-file=<(grep -E '^[A-Z0-9_]+=.+' k8s/.env.local)
# To change it later, add `--dry-run=client -o yaml | kubectl apply -f -` to the same command, then
# `kubectl rollout restart` the Deployment (pods don't pick up Secret changes on their own).
# One KEY=VALUE per line, no quotes, no inline comments. Don't set PORT — the Deployment sets it
# from the ConfigMap's APP_PORT. Project info (APP_*) lives in the ConfigMap (k8s/config.env.example).

# ── JWT (required) — generate each with: openssl rand -base64 32 ─────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS (required) — comma-separated exact origins, e.g. https://admin.example.com
CORS_ORIGINS=

# ── Reverse-proxy hops. Default 1 (one ingress-nginx hop) ────────────────────
TRUST_PROXY=1

# ── Rate limit (auth-mutation routes). Defaults: 5 / 10 ─────────────────────
RATE_LIMIT_FPS=
RATE_LIMIT_BURST=

# ── Content types dir. Default content-types ───────────────────────────────
CONTENT_TYPES_DIR=

# ── Media — max upload bytes. Default 10485760 (10 MiB) ────────────────────
MEDIA_MAX_UPLOAD_BYTES=

# ── Database (required) — Postgres on the Mac, reached via its bridge IP ────
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── Storage — cloudinary (default) or s3; fill in only the one you use ─────
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_S3_BUCKET=

# ── Email — gmail | smtp | resend | brevo | console (default) ───────────────
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
FRONTEND_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
RESEND_API_KEY=
BREVO_API_KEY=

# ── Redis (optional refresh-token blacklist cache). REDIS_URL required if true
REDIS_ENABLED=false
REDIS_URL=
