# cms-api's k3s release, built from the shared helmfile-chart-template chart (source lives in its own
# repo). Pre-req: the namespace + Secret from secret.yaml already exist (apply it first).
#
# The chart's identity values come from env vars. Load them from a .env file when running the CLI
# (it's gitignored); every one is required:
#
#   | Env var            | Chart value    | cms-api prod  | Meaning                        |
#   |--------------------|----------------|---------------|--------------------------------|
#   | `APP_NAME`         | `appName`      | `abyssoftime` | Application / product name     |
#   | `APP_SERVICE_NAME` | `serviceName`  | `cms-api`     | Service within the application |
#   | `APP_NAMESPACE`    | `appNamespace` | `abyssoftime` | Base namespace                 |
#   | `APP_ENV`          | `appEnv`       | `prod`        | Environment                    |
#   | `APP_PORT`         | `appPort`      | `3000`        | Container and Service port     |
#
# The release name and namespace are derived from them. Everything else lives in values.yaml.
#
# APP_PORT must match the Secret's PORT key (the app listens on process.env.PORT) — the chart can't
# read the Secret, so keep the two in sync by hand.
#
# No `version:` on the release on purpose — every deploy uses the latest published chart. helmfile
# caches an unversioned OCI chart and won't refresh it on its own, so always clear the cache first:
#
#   set -a && . ./.env && set +a
#   helmfile cache cleanup && helmfile diff
#   helmfile cache cleanup && helmfile apply
#
# `helmfile apply` doesn't restart pods when the rendered manifests are unchanged (same `latest`
# image tag). To roll out newly pushed images:
#
#   kubectl -n abyssoftime-prod rollout restart deploy/abyssoftime-cms-api-prod
repositories:
  - name: hungnh1812dev
    url: ghcr.io/hungnh1812dev
    oci: true

releases:
  - name: {{ requiredEnv "APP_NAME" }}-{{ requiredEnv "APP_SERVICE_NAME" }}-{{ requiredEnv "APP_ENV" }}
    # The chart fails the render unless the release namespace is <appNamespace>-<appEnv>.
    namespace: {{ requiredEnv "APP_NAMESPACE" }}-{{ requiredEnv "APP_ENV" }}
    chart: hungnh1812dev/helmfile-chart-template
    values:
      - appName: {{ requiredEnv "APP_NAME" }}
        serviceName: {{ requiredEnv "APP_SERVICE_NAME" }}
        appNamespace: {{ requiredEnv "APP_NAMESPACE" }}
        appEnv: {{ requiredEnv "APP_ENV" }}
        appPort: {{ requiredEnv "APP_PORT" }}
      - values.yaml
