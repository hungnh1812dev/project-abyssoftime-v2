# cms-api's k3s releases:
#   1. <name>-secrets — the runtime Secret, rendered by the local ./secrets-chart.
#   2. <name>         — the app, built from the shared helmfile-chart-template chart (source lives in
#                       its own repo). It `needs` the Secret release, so the Secret always lands first.
#
# Everything is read from environment variables, so export them before running the CLI (e.g. source
# a gitignored env file made from k8s/.env.example; any file name works). The chart's identity
# values are required:
#
#   | Env var            | Chart value    | cms-api prod  | Meaning                        |
#   |--------------------|----------------|---------------|--------------------------------|
#   | `APP_NAME`         | `appName`      | `abyssoftime` | Application / product name     |
#   | `APP_SERVICE_NAME` | `serviceName`  | `cms-api`     | Service within the application |
#   | `APP_NAMESPACE`    | `appNamespace` | `abyssoftime` | Base namespace                 |
#   | `APP_ENV`          | `appEnv`       | `prod`        | Environment                    |
#   | `APP_PORT`         | `appPort`      | `3000`        | Container and Service port     |
#   | `APP_IMAGE_TAG`    | `image.tag`    | `latest`      | Image tag, or a short SHA to pin (values.yaml.gotmpl) |
#
# The release names and namespace are derived from them. The Secret gets every non-APP_* key listed
# in k8s/.env.example whose env var is set and non-empty (the key names come from the committed
# template, the values only from the environment, so no real env file is ever read here). PORT is
# always set from APP_PORT so the app and the chart can't disagree on the port. A new app env var
# must be added to k8s/.env.example to reach the Secret.
#
# No `version:` on the app release on purpose — every deploy uses the latest published chart.
# helmfile caches an unversioned OCI chart and won't refresh it on its own, so always clear the
# cache first:
#
#   set -a && . ./.env.local && set +a
#   helmfile cache cleanup && helmfile diff
#   helmfile cache cleanup && helmfile apply
#
# `helmfile apply` doesn't restart pods when the rendered manifests are unchanged (same `latest`
# image tag), and a changed Secret alone doesn't restart them either. Setting APP_IMAGE_TAG to a new
# short SHA rolls out normally; otherwise, to pick up re-pushed `latest` images or new Secret values:
#
#   kubectl -n abyssoftime-prod rollout restart deploy/abyssoftime-cms-api-prod
{{- $name := printf "%s-%s-%s" (requiredEnv "APP_NAME") (requiredEnv "APP_SERVICE_NAME") (requiredEnv "APP_ENV") }}
{{- $namespace := printf "%s-%s" (requiredEnv "APP_NAMESPACE") (requiredEnv "APP_ENV") }}
{{- $env := dict }}
{{- range $line := readFile ".env.local" | splitList "\n" }}
{{-   $line = trim $line }}
{{-   if and $line (not (hasPrefix "#" $line)) (contains "=" $line) }}
{{-     $key := trim (splitn "=" 2 $line)._0 }}
{{-     $value := env $key }}
{{-     if and $value (not (hasPrefix "APP_" $key)) }}
{{-       $_ := set $env $key $value }}
{{-     end }}
{{-   end }}
{{- end }}
{{- $_ := set $env "PORT" (requiredEnv "APP_PORT") }}

repositories:
  - name: hungnh1812dev
    url: ghcr.io/hungnh1812dev
    oci: true

releases:
  - name: {{ $name }}-secrets
    namespace: {{ $namespace }}
    chart: ./secrets-chart
    values:
      # The Secret name is fixed by helmfile-chart-template: <appName>-<serviceName>-secrets-<appEnv>.
      - secretName: {{ requiredEnv "APP_NAME" }}-{{ requiredEnv "APP_SERVICE_NAME" }}-secrets-{{ requiredEnv "APP_ENV" }}
        env: {{ $env | toJson }}

  - name: {{ $name }}
    # The chart fails the render unless the release namespace is <appNamespace>-<appEnv>.
    namespace: {{ $namespace }}
    chart: hungnh1812dev/helmfile-chart-template
    needs:
      - {{ $namespace }}/{{ $name }}-secrets
    values:
      - appName: {{ requiredEnv "APP_NAME" }}
        serviceName: {{ requiredEnv "APP_SERVICE_NAME" }}
        appNamespace: {{ requiredEnv "APP_NAMESPACE" }}
        appEnv: {{ requiredEnv "APP_ENV" }}
        appPort: {{ requiredEnv "APP_PORT" }}
      - values.yaml.gotmpl
