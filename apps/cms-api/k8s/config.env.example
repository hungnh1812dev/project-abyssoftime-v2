# cms-api project info — the keys of the <full-app-name>-config ConfigMap that Flux substitutes into
# k8s/flux/app/*. Copy this file somewhere private, fill it in, and create the ConfigMap before the
# first deploy (placeholders only here — never commit real values):
#   kubectl -n flux-system create configmap <app-name>-<app-service-name>-<app-env>-config \
#     --from-env-file=<your filled-in copy>
# Derived names: namespace <APP_NAMESPACE>-<APP_ENV>, app <APP_NAME>-<APP_SERVICE_NAME>-<APP_ENV>.

# Application / product name
APP_NAME=
# Service within the application
APP_SERVICE_NAME=
# Base namespace (the app runs in <APP_NAMESPACE>-<APP_ENV>)
APP_NAMESPACE=
# Environment, e.g. prod
APP_ENV=
# Container + Service port; also set as the app's PORT
APP_PORT=
# Image repository without a tag (the app image is <repo>:<tag>, the init image <repo>:<tag>-init)
APP_IMAGE_REPO=
