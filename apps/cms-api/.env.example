# Server
# HTTP port the server listens on (src/main.ts). Defaults to 3000 if unset.
PORT=

# JWT token
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cookie
COOKIE_SECURE=
COOKIE_SAMESITE=

# CORS — comma-separated exact origins allowed credentialed access to /api/v1/*, e.g.
# http://localhost:3000,https://admin.example.com. Required, no default (fails boot if unset).
# /api/v1/public/documents/* is open to any origin regardless of this value. See docs/documents/cors.md.
CORS_ORIGINS=

# Hops of X-Forwarded-For to trust in front of this app (see docs/documents/auth.md). Default "1".
TRUST_PROXY=

# Rate limit (auth-mutation routes). Defaults: RATE_LIMIT_FPS=5, RATE_LIMIT_BURST=10
RATE_LIMIT_FPS=
RATE_LIMIT_BURST=

# Content types — directory of schema-as-code JSON definitions. Default "content-types"
CONTENT_TYPES_DIR=

# Media
# Max upload size in bytes. Default 10485760 (10 MiB)
MEDIA_MAX_UPLOAD_BYTES=

# Storage — "cloudinary" or "s3". Default "cloudinary"
STORAGE_PROVIDER=
# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3 (required when STORAGE_PROVIDER=s3)
AWS_REGION=
AWS_S3_BUCKET=

# Database connection
# DB_DRIVER: "postgresql" | "mysql" | "sqlite". Defaults: postgresql, localhost, abyssoftime-cms, "", 5432, postgres
DB_DRIVER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_USERNAME=

# Email Sender
#EMAIL_PROVIDER: "gmail" | "smtp" | "resend" | "console". Defaults: console (dev/test fallback)
EMAIL_PROVIDER=
# SMTP_HOST unset = use ConsoleEmailSender (dev/test fallback), see resolve-email-sender.ts
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
EMAIL_FROM=
FRONTEND_URL=
# Gmail API credentials (optional, for sending email via Gmail API instead of SMTP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Resend (https://resend.com) — optional, for sending email via Resend instead of SMTP/Gmail
RESEND_API_KEY=

# Redis — optional cache for the refresh-token blacklist. Default false (Postgres-only, no Redis
# connection attempted). REDIS_URL is required when REDIS_ENABLED=true. See
# docs/documents/token-blacklist-techstack.md.
REDIS_ENABLED=
REDIS_URL=
