generator client {
    provider = "prisma-client-js"
    output = "./../../src/prisma/application/client"
}

datasource db {
    provider = "postgresql"
}

model Permission {
    id          Int         @default(autoincrement())
    documentId  String      @id @unique @default(uuid()) @map("document_id")
    slug        String      @unique
    name        String
    description String
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    // Who updated this Permission
    user        User?       @relation("PermissionUpdatedBy", fields: [updatedBy], references: [documentId])
    updatedBy   String?     @map("updated_by")

    @@map("permissions")
}

model Role {
    id          Int         @default(autoincrement())
    documentId  String      @id @unique @default(uuid()) @map("document_id")
    name        String
    slug        String      @unique
    permissions Json
    level       Int
    isDefault   Boolean     @map("is_default")
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    // Who updated this Role
    user        User?       @relation("RoleUpdatedBy", fields: [updatedBy], references: [documentId])
    updatedBy   String?     @map("updated_by")

    users       User[]      @relation("UserRole")

    @@map("roles")
}

model AccessToken {
    id          Int         @default(autoincrement())
    documentId  String      @id @unique @default(uuid()) @map("document_id")
    name        String
    token       String      @unique
    permissions Json
    expiresAt   DateTime?   @map("expires_at")
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    // Who updated this AccessToken
    user        User?       @relation("AccessTokenUpdatedBy", fields: [updatedBy], references: [documentId])
    updatedBy   String?     @map("updated_by")

    @@map("access_tokens")
}

model MediaAsset {
    id           Int      @default(autoincrement())
    documentId   String   @id @unique @default(uuid()) @map("document_id")
    fileName     String   @map("file_name")
    mimeType     String   @map("mime_type")
    size         Int
    width        Int
    height       Int
    url          String
    thumbnailUrl String   @map("thumbnail_url")
    publicId     String   @map("public_id")
    hash         String
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    // Who uploaded this MediaAsset
    user         User?    @relation("MediaAssetUploadedBy", fields: [uploadedBy], references: [documentId])
    uploadedBy   String?  @map("uploaded_by")

    @@map("media_assets")
}

model ContentType {
    id                 Int      @default(autoincrement())
    documentId         String   @id @unique @default(uuid()) @map("document_id")
    slug               String   @unique
    name               String
    kind               String
    draftToPublish     Boolean  @map("draft_to_publish")
    fields             Json
    listFields         Json     @map("list_fields")
    listFieldsOverride Json?    @map("list_fields_override")
    createdAt          DateTime @default(now()) @map("created_at")
    updatedAt          DateTime @updatedAt @map("updated_at")

    @@map("content_types")
}

model User {
    id          Int         @default(autoincrement())
    documentId  String      @id @unique @default(uuid()) @map("document_id")
    email       String      @unique
    name        String      @map("display_name")
    username    String      @unique
    password    String      @map("password_hash")
    accountType Boolean     @map("account_type")
    verified    Boolean
    role        Role?       @relation("UserRole", fields: [roleId], references: [documentId])
    roleId      String?     @map("role_id")
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    otpCodeHash          String?   @map("otp_code_hash")
    otpExpiresAt         DateTime? @map("otp_expires_at")
    resetTokenHash       String?   @map("reset_token_hash")
    resetTokenExpiresAt  DateTime? @map("reset_token_expires_at")

    updatedRoles        Role[]        @relation("RoleUpdatedBy") @ignore
    updatedPermissions  Permission[]  @relation("PermissionUpdatedBy") @ignore
    updatedAccessTokens AccessToken[] @relation("AccessTokenUpdatedBy") @ignore
    uploadedMediaAssets MediaAsset[]  @relation("MediaAssetUploadedBy") @ignore

    @@index([roleId])
    @@map("users")
}

// Revoked refresh-token jtis (logout or rotation). Not a client-facing CRUD resource — jti is
// already a UUID and serves as the primary key, so this deliberately skips the documentId/
// updatedAt/updatedBy convention the other models use. userId has no @relation (unused today,
// groundwork for a future "log out everywhere" feature — see docs/documents/token-blacklist.md).
model RefreshTokenBlacklist {
    jti       String   @id
    userId    String?  @map("user_id")
    reason    String
    expiresAt DateTime @map("expires_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@index([expiresAt])
    @@map("refresh_token_blacklist")
}